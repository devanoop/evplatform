DATABASE_URL=postgresql://ev:ev@localhost:5432/ev
MARKET=IN
INGEST_SOURCES=india_curated,oem_pages
ADMIN_TOKEN=change-me
# Optional: enables the oem_pages source (Claude extracts specs from official pages)
ANTHROPIC_API_KEY=
# Optional: run ingestion inside the web process instead of a cron service
ENABLE_INPROCESS_SCHEDULER=false
# Car photos from Wikimedia Commons, refreshed after each ingest (true by default)
ENABLE_PHOTOS=true
# Identify the bot to Wikimedia and OEM sites; include a URL where people can reach you
HTTP_USER_AGENT=RangewiseBot/0.1 (+https://your-domain/#/about)
